# Groq API key; keep real credentials in .env or the deployment environment.
GROQ_API_KEY=
# Groq chat completion model.
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Groq audio/video transcription model.
GROQ_WHISPER_MODEL=whisper-large-v3
# FastEmbed text embedding model.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# SQLite file path; use /data/studymate.db on Render.
DATABASE_PATH=studymate.db
# Uploaded source files; use /data/uploads on Render.
UPLOADS_DIR=uploads
# ChromaDB data directory; use /data/chroma_data on Render.
CHROMA_DIR=chroma_data
# Replace with a long, random secret before deployment.
JWT_SECRET=replace-this-with-a-long-random-secret
# JWT expiry in minutes.
JWT_EXPIRE_MINUTES=1440
# Collection name isolates FastEmbed vectors from the previous embedding space.
CHROMA_COLLECTION=studymate_v2
# Persistent FastEmbed model cache; use /data/model_cache on Render.
MODEL_CACHE_DIR=model_cache
# Comma-separated browser origins allowed by the API.
FRONTEND_ORIGINS=http://localhost:5173
